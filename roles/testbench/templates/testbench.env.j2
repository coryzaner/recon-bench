# {{ ansible_managed }}
# /etc/testbench/testbench.env — read by recon-guard. No secrets here.
TB_ETC={{ testbench_etc }}
TB_SCOPE={{ testbench_etc }}/scope.yaml
TB_AUTH={{ testbench_etc }}/authorization.yml
TB_AUTH_SIG={{ testbench_etc }}/authorization.yml.sig
TB_KEYRING={{ testbench_keyring }}
TB_BIN={{ testbench_bin }}
TB_SCOPE_CHECK={{ testbench_prefix }}/scope_check.py
TB_ALLOW_NO_SIG={{ '1' if testbench_allow_no_sig | bool else '0' }}
